# Everything here is optional. With no keys the app runs on the built-in pilot dataset.
PORT=3000
HOST=127.0.0.1

# Live venue search
YELP_API_KEY=
GOOGLE_PLACES_API_KEY=

# Instagram trend scanning (Instagram Graph API hashtag search; needs a Business/Creator account)
IG_USER_ID=
IG_ACCESS_TOKEN=

# "Send it for me" reservation requests
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
